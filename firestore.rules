rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each anonymous user can read and write only their own redacted cases.
    match /users/{uid}/cases/{caseId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'organisation', 'commissionerDeadline', 'sheet', 'drafts', 'createdAt'])
        && request.resource.size() < 200 * 1024;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
